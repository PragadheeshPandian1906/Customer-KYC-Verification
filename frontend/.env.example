# KYC Frontend Environment Configuration
# Copy this file to .env.local or .env for local development:
#   cp .env.example .env.local

# Backend API Base URL (used when not relying exclusively on the Vite dev proxy)
VITE_API_BASE_URL=http://localhost:8080

# Mirror backend application.yml if KYC_* backend workflow settings are customized.
# These values only configure what the frontend displays; the backend remains authoritative.
VITE_KYC_VERIFICATION_CHECK_TYPES=CUSTOMER_INFORMATION,IDENTITY_DOCUMENT,ADDRESS_DOCUMENT
VITE_KYC_REQUIRED_CHECK_TYPES=CUSTOMER_INFORMATION,IDENTITY_DOCUMENT,ADDRESS_DOCUMENT
VITE_KYC_REQUIRED_DOCUMENT_TYPES=IDENTITY_EVIDENCE
