# Database configuration
DB_URL=jdbc:mysql://localhost:3306/kyc_verification?serverTimezone=UTC
DB_USERNAME=kyc_app
DB_PASSWORD=replace_with_your_local_mysql_password

# Demo user passwords - use fictional development-only passwords
DEMO_CUSTOMER_PASSWORD=replace_with_customer_password
DEMO_ANALYST_PASSWORD=replace_with_analyst_password
DEMO_SUPERVISOR_PASSWORD=replace_with_supervisor_password
DEMO_ADMIN_PASSWORD=replace_with_admin_password

# Document encryption key - generate a real key as explained below
KYC_STORAGE_KEY=REPLACE_WITH_GENERATED_BASE64_KEY

# Optional document storage settings
KYC_STORAGE_ROOT=D:/IOC-Project/kyc-private-storage
KYC_MAX_FILE_SIZE=10485760
